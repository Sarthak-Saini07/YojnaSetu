# ==============================================================================
# Government Scheme Recommendation System - Environment Variables Template
# Copy this file to '.env' for local development or configure in your hosting platform.
# ==============================================================================

# Database Connection (MongoDB)
# Option A: Local Development (Default)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=government_scheme_db

# Option B: MongoDB Atlas Production (Configure on Render / Hosting Dashboard)
# MONGODB_URI=mongodb+srv://sarthaksaini23_db_user:<actual_password>@govt.1odpl43.mongodb.net/government_scheme_db?retryWrites=true&w=majority
# DATABASE_NAME=government_scheme_db

# Security & Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here
ENVIRONMENT=development  # Set to "production" on Render

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000  # Automatically assigned by Render in production ($PORT)

# CORS Configuration (Comma-separated allowed frontend origins)
# Render *.onrender.com frontend domains are automatically permitted by regex.
# Add custom domain here if applicable:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Bootstrap (Created on initial startup if no admin exists)
ADMIN_EMAIL=admin@gov.in
ADMIN_PASSWORD=your_secure_admin_password_here

# AI & LLM Provider Configuration (Backend-Only)
LLM_PROVIDER=mock  # Options: mock, gemini, openai
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT=10
