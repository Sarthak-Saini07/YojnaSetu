# Frontend Environment Variables Template
# Copy to frontend/.env for local development override or configure in Render Static Site dashboard.

# Local Development (or omit to use Vite's internal proxy to http://127.0.0.1:8000)
# VITE_API_BASE_URL=http://localhost:8000

# Production (Set in Render Dashboard -> Static Site -> Environment Variables)
# Replace with your deployed Render backend web service URL:
# VITE_API_BASE_URL=https://govt-scheme-api.onrender.com

